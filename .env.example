# ---------------------------------------------------------------------------
# HomeHi environment
# Copy to .env (or .env.local) and change the secrets before exposing publicly.
# ---------------------------------------------------------------------------

# SQLite path is relative to prisma/schema.prisma.
DATABASE_URL="file:../data/homehi.db"

# Public URL used in emails and absolute links (no trailing slash).
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Long random string, at least 32 characters. `openssl rand -base64 48`
AUTH_SECRET="replace-me-with-a-long-random-string"

# Household defaults. Timezone must be an IANA name.
DEFAULT_TIMEZONE="Asia/Shanghai"

# Local media storage. Abstraction lives in lib/storage.ts.
STORAGE_DIR="./storage"
MAX_UPLOAD_MB="100"

# Optional SMTP. Leave SMTP_HOST empty to keep notifications visibly "not configured".
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="HomeHi <hello@example.com>"

# Worker
WORKER_POLL_SECONDS="30"
WORKER_REMINDER_HORIZON_DAYS="180"
