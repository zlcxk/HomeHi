# ---------------------------------------------------------------------------
# HomeHi environment
# Copy to .env (or .env.local) and change the secrets before exposing publicly.
# ---------------------------------------------------------------------------

# SQLite path is relative to prisma/schema.prisma.
DATABASE_URL="file:../data/homehi.db"

# Public URL used in emails and absolute links (no trailing slash).
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Long random string, at least 32 characters. `openssl rand -base64 48`
AUTH_SECRET="replace-me-with-a-long-random-string"

# 会话 Cookie 的 Secure 标记。留空自动判断：反向代理传了
# x-forwarded-proto: https 才加 Secure。用局域网 IP + HTTP 访问时不要设为 true，
# 否则浏览器会丢弃登录 Cookie，表现为登录后立刻退出。全站 HTTPS 时可设为 true。
# COOKIE_SECURE="false"

# Household defaults. Timezone must be an IANA name.
DEFAULT_TIMEZONE="Asia/Shanghai"

# Media storage. Prefer configuring this in the UI at 设置 → 存储; these values
# only seed the initial/default configuration.
# STORAGE_DRIVER="local"   # local | oss
STORAGE_DIR="./storage"
MAX_UPLOAD_MB="100"

# Optional Aliyun OSS (used when STORAGE_DRIVER=oss).
OSS_REGION=""
OSS_BUCKET=""
OSS_ACCESS_KEY_ID=""
OSS_ACCESS_KEY_SECRET=""
OSS_ENDPOINT=""
OSS_PREFIX="homehi"

# Optional SMTP. Leave SMTP_HOST empty to keep notifications visibly "not configured".
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="HomeHi <hello@example.com>"

# 高德地图 Web 服务 API（地点联想）。请使用「Web 服务」类型的 Key，
# 不是 JS API Key。只会在服务端调用，不会下发到浏览器。
# 开启后，瞬间/手记/待办/日程/物品里的地点输入会实时联想。
AMAP_API_KEY=""
# 可选：限定联想城市，例如 北京、310000（adcode）。留空则全国搜索。
AMAP_CITY=""

# Worker
WORKER_POLL_SECONDS="30"
WORKER_REMINDER_HORIZON_DAYS="180"

# 可选：视频压缩使用的 ffmpeg。留空时依次尝试 ffmpeg-static 和系统 ffmpeg。
# FFMPEG_PATH=""
