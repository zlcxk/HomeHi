# ---------------------------------------------------------------------------
# HomeHi environment
# Copy to .env (or .env.local) and change the secrets before exposing publicly.
# ---------------------------------------------------------------------------

# SQLite path is relative to prisma/schema.prisma.
DATABASE_URL="file:../data/homehi.db"

# Public URL used in emails and absolute links (no trailing slash).
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Long random string, at least 32 characters. `openssl rand -base64 48`
AUTH_SECRET="replace-me-with-a-long-random-string"

# 会话 Cookie 的 Secure 标记。留空自动判断：反向代理传了
# x-forwarded-proto: https 才加 Secure。用局域网 IP + HTTP 访问时不要设为 true，
# 否则浏览器会丢弃登录 Cookie，表现为登录后立刻退出。全站 HTTPS 时可设为 true。
# COOKIE_SECURE="false"

# Household defaults. Timezone must be an IANA name.
DEFAULT_TIMEZONE="Asia/Shanghai"

# Media storage. Prefer configuring this in the UI at 设置 → 存储; these values
# only seed the initial/default configuration.
# STORAGE_DRIVER="local"   # local | oss
STORAGE_DIR="./storage"
MAX_UPLOAD_MB="100"

# Optional Aliyun OSS (used when STORAGE_DRIVER=oss).
# 建议在阿里云 RAM 中为 HomeHi 单独创建子账号，只授予该 Bucket 的读写权限，
# 并定期轮换密钥。AccessKey Secret 会以明文保存在 SQLite 数据库里，请限制
# 数据库文件的访问权限。切换存储只影响之后上传的文件，已有文件仍按上传时的
# 后端读取，所以两种后端同时存在也能正常打开。
OSS_REGION=""
OSS_BUCKET=""
OSS_ACCESS_KEY_ID=""
OSS_ACCESS_KEY_SECRET=""
OSS_ENDPOINT=""
OSS_PREFIX="homehi"

# Optional SMTP. Leave SMTP_HOST empty to keep notifications visibly "not configured".
# 提醒邮件由 worker 进程发送；Docker 部署请同时启动 web 和 worker 两个服务。
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="HomeHi <hello@example.com>"

# 高德地图 Web 服务 API（地点联想）。请使用「Web 服务」类型的 Key，
# 不是 JS API Key。只会在服务端调用，不会下发到浏览器。
# 开启后，瞬间/手记/待办/日程/物品里的地点输入会实时联想。
AMAP_API_KEY=""
# 可选：限定联想城市，例如 北京、310000（adcode）。留空则全国搜索。
AMAP_CITY=""

# Worker
# worker 负责三件事：到期提醒、图片变体（240px 缩略图 / 960px 预览图）、
# 视频封面与 H.264 播放版。生产环境必须常驻运行，并与 web 共享 STORAGE_DIR。
WORKER_POLL_SECONDS="30"
WORKER_REMINDER_HORIZON_DAYS="180"

# 媒体处理
# 缩略图也会在首次请求 /api/media/{id}/thumb 时按需生成；worker 负责批量补齐。
# 历史数据可重复执行：npm run media:backfill -- --type=all --retry-failed
# --type 可取 all | image | video；--limit=N 限制处理数量。
#
# 视频封面和转码需要 ffmpeg。留空时依次尝试 ffmpeg-static 和系统 ffmpeg；
# 都没有时视频仍可播放原文件，只是没有封面和压缩版。
# FFMPEG_PATH=""

# 备份：npm run backup 会把 SQLite 数据库和本地 STORAGE_DIR 复制到带时间戳的
# 目录。使用 OSS 时媒体不在本地，请用 OSS 的版本控制或跨区域复制。
# Backup directory defaults to ./backups and can be changed with BACKUP_DIR.
# BACKUP_DIR="./backups"
