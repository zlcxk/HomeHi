{
  "name": "homehi",
  "version": "0.1.0",
  "private": true,
  "description": "HomeHi — 私人家庭生活记录与事项管理",
  "scripts": {
    "dev": "node scripts/ensure-dirs.mjs && prisma migrate deploy && next dev",
    "dev:all": "node scripts/ensure-dirs.mjs && prisma migrate deploy && concurrently -n web,worker -c cyan,magenta \"next dev\" \"npm:worker\"",
    "build": "prisma generate && next build",
    "start": "node scripts/ensure-dirs.mjs && prisma migrate deploy && next start",
    "worker": "tsx watch scripts/worker.ts",
    "worker:prod": "tsx scripts/worker.ts",
    "backup": "tsx scripts/backup.ts",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset --force",
    "seed": "tsx scripts/seed.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "tsx scripts/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "archiver": "^8.0.0",
    "bcryptjs": "^3.0.3",
    "exifr": "^7.1.3",
    "jose": "^6.2.13",
    "lucide-react": "^1.61.0",
    "luxon": "^3.7.2",
    "next": "16.4.3",
    "nodemailer": "^10.2.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/archiver": "^8.0.0",
    "@types/bcryptjs": "^3.0.0",
    "@types/luxon": "^3.7.6",
    "@types/node": "^24.10.1",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "concurrently": "^9.2.1",
    "dotenv": "^17.2.3",
    "prisma": "6.19.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "3.2.4"
  }
}
